# Skopiuj do .env.local i wypełnij przed deploy:
# (na Vercel: Settings → Environment Variables)

# Pełny URL strony po podpięciu domeny, np. https://marekbaranski.pl
# Do tego czasu zostaw puste — strona działa na *.vercel.app
NEXT_PUBLIC_SITE_URL=

# Endpoint formularza kontaktowego (formspree.io → Forms → endpoint)
# Do tego czasu formularz pokaże komunikat "zadzwoń/mail" zamiast wysyłać.
NEXT_PUBLIC_FORM_ENDPOINT=
